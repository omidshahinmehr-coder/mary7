<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent">

<!-- دکمه انتخاب زبان - همیشه روی همه چیز -->
<ImageButton
android:id="@+id/languageButton"
android:layout_width="44dp"
android:layout_height="44dp"
android:layout_margin="12dp"
android:background="?attr/selectableItemBackgroundBorderless"
android:padding="8dp"
android:src="@drawable/ic_language"
android:contentDescription="@string/language_button_description"
app:layout_constraintTop_toTopOf="parent"
app:layout_constraintEnd_toEndOf="parent" />

<!-- محتوای صفحه داخل ScrollView -->
<ScrollView
android:id="@+id/mainScroll"
android:layout_width="0dp"
android:layout_height="0dp"
android:fillViewport="true"
app:layout_constraintTop_toBottomOf="@id/languageButton"
app:layout_constraintBottom_toBottomOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:gravity="center"
android:padding="24dp">

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="@string/app_name"
android:textSize="22sp"
android:textStyle="bold"
android:paddingBottom="8dp" />

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="@string/mode_selection_subtitle"
android:paddingBottom="32dp" />

<Button
android:id="@+id/trackerModeButton"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:padding="16dp"
android:text="@string/mode_selection_tracker_button" />

<Button
android:id="@+id/viewerModeButton"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="16dp"
android:padding="16dp"
android:text="@string/mode_selection_viewer_button" />

<Button
android:id="@+id/securitySettingsButton"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginTop="32dp"
android:text="@string/mode_selection_security_button" />

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginTop="32dp"
android:layout_marginBottom="24dp"
android:text="@string/about_credit"
android:textColor="@color/color_text_hint"
android:textSize="12sp" />

</LinearLayout>

</ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
