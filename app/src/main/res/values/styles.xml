<resources>

    <!-- دکمه‌ها با سایز کوچک‌تر -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="rippleColor">@color/color_accent</item>
    </style>


    <!-- تم مخصوص گوشی‌های کوچک -->
    <style name="Theme.App" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- رنگ‌ها مثل نسخه اصلی -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="colorSecondary">@color/color_accent</item>
        <item name="colorControlActivated">@color/color_accent</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="android:statusBarColor">@color/color_primary_dark</item>

        <!-- فونت estedad -->
        <item name="android:fontFamily">@font/estedad</item>
        <item name="fontFamily">@font/estedad</item>

        <!-- متن‌های کوچک‌تر -->
        <item name="textAppearanceBody1">@style/AppTextAppearance.Small</item>
        <item name="textAppearanceBody2">@style/AppTextAppearance.Small</item>
        <item name="textAppearanceHeadline1">@style/AppTitleAppearance.Small</item>

    </style>


    <!-- متن‌های معمولی کوچک‌تر -->
    <style name="AppTextAppearance.Small" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/estedad</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- عنوان‌ها کوچک‌تر -->
    <style name="AppTitleAppearance.Small" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/estedad</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
